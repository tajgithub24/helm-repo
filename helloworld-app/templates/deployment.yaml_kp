apiVersion: apps/v1
kind: Deployment
metadata:
  name: helloworld-app
  namespace: devops
spec:
  replicas: 2
  selector:
    matchLabels:
      app: helloworld-app
  template:
    metadata:
      labels:
        app: helloworld-app
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: "kubernetes.io/hostname"
                    operator: In
                    values:
                      - aks-nodepool2-21297073-vmss000001
      containers:
        - name: helloworld-container
          image: taj070796/helloworld:latest
          ports:
            - containerPort: 8080
      imagePullSecrets:
        - name: dockerhub-secret

